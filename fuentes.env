# Parámetros del pipeline (los lee cargar.sh). Los archivos fuente se buscan por patrón en ./datos
ZONA=santiago-centro
# Caja lon/lat (WGS84): xmin ymin xmax ymax — la del enunciado y de preparar_datos.py del Lab 05
BBOX="-70.75 -33.52 -70.52 -33.36"
PBF_GLOB="*.osm.pbf"
GTFS_GLOB="GTFS_*.zip"
COMUNAS_SQL="comunas_cl.sql"
